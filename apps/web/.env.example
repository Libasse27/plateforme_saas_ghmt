# URL de l'API GHMT (côté serveur uniquement, jamais exposée au navigateur).
API_URL=http://localhost:3000/api/v1

# "true" : cookies de session avec l'attribut Secure et le préfixe __Host- (obligatoire en production, HTTPS).
# "false" : développement local en HTTP. Par défaut : true si NODE_ENV=production.
SESSION_COOKIE_SECURE=false
