# Copier en .env — valeurs de DÉVELOPPEMENT uniquement.
NODE_ENV=development
PORT=3000
# Rôle applicatif soumis au RLS (jamais propriétaire des tables)
DATABASE_URL=postgresql://ghmt_app:ghmt_app_dev@localhost:5432/ghmt
# Rôle ghmt_platform (schéma platform uniquement) : console plateforme, abonnements, paiements
PLATFORM_DATABASE_URL=postgresql://ghmt_platform:ghmt_platform_dev@localhost:5432/ghmt
# Rôle propriétaire utilisé uniquement par `prisma migrate`
MIGRATION_DATABASE_URL=postgresql://ghmt_migrator:ghmt_migrator_dev@localhost:5432/ghmt
# Secret de signature des JWT d'accès (>= 32 octets aléatoires) : openssl rand -base64 48
JWT_ACCESS_SECRET=
# Secret des JWT du realm plateforme (>= 32 caractères, DISTINCT de JWT_ACCESS_SECRET ; obligatoire en production) : openssl rand -base64 48
JWT_PLATFORM_SECRET=
JWT_ISSUER=https://api.ghmt.local
JWT_AUDIENCE=ghmt-api
# Clé maîtresse AES-256-GCM pour les champs sensibles (32 octets en base64) : openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Clé HMAC des index aveugles (32 octets en base64) : openssl rand -base64 32
BLIND_INDEX_KEY=
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3001
# Proxys de confiance pour X-Forwarded-For (CIDR séparés par des virgules, ou « loopback »)
# Proxys de confiance (CIDR, séparés par des virgules) : OBLIGATOIRE en production (adresse du BFF et des proxys).
TRUSTED_PROXIES=loopback
# URL publique de l'application web (lien des e-mails d'invitation)
WEB_URL=http://localhost:3001
# Serveur SMTP (Mailpit en développement : localhost:1025) et expéditeur
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=GHMT <no-reply@ghmt.local>
# Paiements : fournisseur simulé (développement/tests ; INTERDIT en production, refusé au démarrage)
PAYMENTS_SANDBOX_ENABLED=true
# Routage optionnel (JSON) : clés PAYS:DEVISE, DEVISE ou *, fournisseurs par ordre de préférence (repli sur le suivant)
# PAYMENTS_ROUTES={"XOF":["cinetpay","sandbox"],"*":["sandbox"]}
# CinetPay (adaptateur inactif tant que clé API, site, clé secrète et URL de notification ne sont pas tous renseignés)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=
# Notifications (docs/10 §8) : worker (dispatcher + jobs), lot et intervalle du dispatcher
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_DISPATCH_INTERVAL_MS=10000
NOTIFICATIONS_BATCH_SIZE=50
# Fournisseur SMS : none (défaut : SMS supprimés avec repli e-mail) | sandbox (dev/test, INTERDIT en production) | http (HTTP générique)
SMS_PROVIDER=sandbox
# Copie des SMS du sandbox vers Mailpit (NODE_ENV=development seulement)
SMS_SANDBOX_MAILBOX=sms-sandbox@ghmt.local
# Adaptateur http : URL (https en production), jeton (16 caractères ou plus), expéditeur alphanumérique de 3 à 11 caractères
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_SENDER_ID=GHMT
# Secret HMAC-SHA256 des webhooks de l'adaptateur http (32 caractères ou plus : openssl rand -hex 32) ; absent = webhooks http en 404
SMS_HTTP_WEBHOOK_SECRET=
SMS_HTTP_TIMEOUT_MS=10000
# Calendrier des relances de factures SaaS : jours relatifs à l'échéance (entiers de -30 à 60, triés)
SAAS_DUNNING_OFFSETS_DAYS=-7,-3,0,3,7,12,15
# Routes /webhooks/sms/sandbox/* (non signées) : dev/test uniquement, désactivées par défaut
SMS_SANDBOX_WEBHOOKS_ENABLED=true
