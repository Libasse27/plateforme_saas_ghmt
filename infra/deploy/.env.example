# Variables NON secrètes de compose.prod.yml. Les secrets sont des fichiers de infra/deploy/secrets/ (init-secrets.sh,
# puis database_url, platform_database_url et migration_database_url fournis par l'exploitant depuis son coffre).
DOMAIN=ghmt.localhost
ACME_ENABLED=
ACME_EMAIL=admin@example.invalid
TRUSTED_PROXY_HOPS=1
JWT_ISSUER=https://ghmt.localhost
JWT_AUDIENCE=ghmt-api
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=GHMT <no-reply@ghmt.localhost>
CSP_MODE=enforce
CSP_REPORT_URI=
CSP_FORM_ACTION_ORIGINS=
