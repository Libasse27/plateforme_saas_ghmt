# URL de l'API GHMT (côté serveur uniquement, jamais exposée au navigateur).
API_URL=http://localhost:3000/api/v1

# "true" : cookies de session avec l'attribut Secure et le préfixe __Host- (obligatoire en production, HTTPS).
# "false" : développement local en HTTP. Par défaut : true si NODE_ENV=production.
SESSION_COOKIE_SECURE=false

# Nombre de proxys de confiance devant le BFF : l'IP cliente est l'entrée `length - hops` de X-Forwarded-For.
# Absent hors production : 1. Obligatoire en production (1 ou plus).
TRUSTED_PROXY_HOPS=1
# Secret partagé avec le proxy de bordure (en-tête X-Ghmt-Edge-Auth), 32 caractères ou plus : openssl rand -base64 48
# Obligatoire en production : sans lui, le BFF refuse toute requête (403).
EDGE_PROXY_SECRET=
# Content-Security-Policy : "enforce" (défaut) ou "report-only" (pré-production).
CSP_MODE=enforce
# URL https facultative de collecte des rapports CSP (report-uri et report-to).
CSP_REPORT_URI=
# Origines https des passerelles de paiement vers lesquelles une Server Action redirige (séparées par des virgules).
CSP_FORM_ACTION_ORIGINS=
