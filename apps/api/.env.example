# Copier en .env — valeurs de DÉVELOPPEMENT uniquement.
NODE_ENV=development
PORT=3000
# Rôle applicatif soumis au RLS (jamais propriétaire des tables)
DATABASE_URL=postgresql://ghmt_app:ghmt_app_dev@localhost:5432/ghmt
# Rôle ghmt_platform (schéma platform uniquement) : console plateforme, abonnements, paiements
PLATFORM_DATABASE_URL=postgresql://ghmt_platform:ghmt_platform_dev@localhost:5432/ghmt
# Rôle propriétaire utilisé uniquement par `prisma migrate`
MIGRATION_DATABASE_URL=postgresql://ghmt_migrator:ghmt_migrator_dev@localhost:5432/ghmt
# Secret de signature des JWT d'accès (>= 32 octets aléatoires) : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=https://api.ghmt.local
JWT_AUDIENCE=ghmt-api
# Clé maîtresse AES-256-GCM pour les champs sensibles (32 octets en base64) : openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Clé HMAC des index aveugles (32 octets en base64) : openssl rand -base64 32
BLIND_INDEX_KEY=
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3001
# Proxys de confiance pour X-Forwarded-For (CIDR séparés par des virgules, ou « loopback »)
# Proxys de confiance (CIDR, séparés par des virgules) : OBLIGATOIRE en production (adresse du BFF et des proxys).
TRUSTED_PROXIES=loopback
# URL publique de l'application web (lien des e-mails d'invitation)
WEB_URL=http://localhost:3001
# Serveur SMTP (Mailpit en développement : localhost:1025) et expéditeur
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=GHMT <no-reply@ghmt.local>
